  <!-- Post-build event to copy the mod to VRChat MelonLoader Mods folder -->
  <Target Name="PostBuild" AfterTargets="PostBuildEvent">
    <Exec Command="mkdir -p &quot;$(VRChatPath)/Mods&quot;" Condition="Exists('$(VRChatPath)')" />
    <Exec Command="cp &quot;$(TargetPath)&quot; &quot;$(VRChatPath)/Mods/&quot;" Condition="Exists('$(VRChatPath)')" />
  </Target>
</Project>